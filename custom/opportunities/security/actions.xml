        <record id="action_opportunity_report" model="ir.actions.server">
            <field name="name">Descargar reporte</field>
            <field name="model_id" ref="opportunities.model_opportunity"/>
            <field name="state">code</field>
            <field name="code">action = model.action_export_xlsx()</field>

            <field name="binding_model_id" eval="False"/>
            <field name="group_ids"
                eval="[(4, ref('opportunities.group_opportunity_dowload_report'))]"/>
        </record>

