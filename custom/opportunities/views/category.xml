<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="opportunity_category_view_list" model="ir.ui.view">
            <field name="name">opportunity.category.view.list</field>
            <field name="model">opportunity.category</field>
            <field name="arch" type="xml">
                <list editable="bottom" duplicate="false" sample="1">
                    <field name="name" string="Nombre"
                        placeholder="Ej. Banca, Hotelería y entrenamiento, etc..."/>
                    <field name="sector_id" string="Sector"
                        options="{'no_create': True, 'no_open': True}"
                        placeholder="Ej. Privado, Público, etc..."/>
                </list>
            </field>
        </record>

    </data>
</odoo>