<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_opportunity_type_list" model="ir.ui.view">
            <field name="name">opportunity.type.list</field>
            <field name="model">opportunity.type</field>
            <field name="arch" type="xml">
                <list string="Sector" sample="1" duplicate="false">
                    <field name="name"
                        placeholder="Ej. Estudio de mercado, RFP, Licitación pública, etc."/>
                </list>
            </field>
        </record>

        <record id="view_opportunity_type_form" model="ir.ui.view">
            <field name="name">opportunity.type.form</field>
            <field name="model">opportunity.type</field>
            <field name="arch" type="xml">
                <form string="Sector" duplicate="false">
                    <sheet>
                        <span style="font-weight: 500; color: #212529;">
                            Nombre
                        </span>
                        <div class="form-title-responsive">
                            <h1>
                                <field name="name" class="text-primary"
                                    placeholder="Ej. Estudio de mercado, RFP, Licitación pública, etc..."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="sector_id" class="text-primary"                                    
                                    options="{'no_create': True, 'no_open': True}"
                                    placeholder="Ej. Público, Privado, etc..."/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>