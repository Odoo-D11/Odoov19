<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="email_template_new_crm_opportunity" model="mail.template">
            <field name="name">Notificación de Oportunidad CRM</field>
            <field name="model_id" ref="opportunities.model_opportunity"/>
            <field name="subject">Nueva Oportunidad CRM</field>
            <field name="email_from">odoo@tsg.net.co</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <table border="0" cellpadding="0" cellspacing="0"
                    style="padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;">
                    <tr>
                        <td align="center">
                            <table border="0" cellpadding="0" cellspacing="0" width="750"
                                style="padding: 16px; background-color: white; color: #454748; border-collapse:separate;">
                                <tbody>
                                    <tr>
                                        <td align="center" style="min-width: 750px;">
                                            <table border="0" cellpadding="0" cellspacing="0"
                                                width="750"
                                                style="min-width: 750px; background-color: white; border-collapse:separate;">
                                                <tr>
                                                    <td valign="middle">
                                                        <span style="font-size: 10px;">
                                                            Buen día,
                                                        </span>
                                                        <br/>
                                                        <span
                                                            style="font-size: 23px; font-weight: bold;">
                                                            <t t-out="ctx.get('employee_name')"/>
                                                        </span>
                                                    </td>
                                                    <td valign="middle" style="text-align: right;"/>
                                                </tr>
                                                <tr>
                                                    <td colspan="2" style="text-align:center;">
                                                        <hr width="100%"
                                                            style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin:16px 0px 16px 0px;"/>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="center" style="min-width: 750px;">
                                            <table border="0" cellpadding="0" cellspacing="0"
                                                width="750"
                                                style="min-width: 750px; background-color: white; border-collapse:separate;">
                                                <tr>
                                                    <td valign="top" style="font-size: 12px;">
                                                        <p> Reciba un cordial saludo, por medio de
                                                            la presente le informamos que la
                                                            oportunidad con referencia <b>
                                                                <t t-out="object.reference"/>
                                                            </b>
                                                            ha sido creada en el sistema. A
                                                            continuación, se detallan los datos de
                                                            la oportunidad: </p>
                                                        <ul>
                                                            <li>
                                                                <b>Nombre de la oportunidad:</b>
                                                                <t t-out="object.name"/>
                                                            </li>
                                                            <li>
                                                                <b>Cliente:</b>
                                                                <t t-out="object.partner_id.name"/>
                                                                <t
                                                                    t-out="object.partner_id.vat"/>
                                                            </li>
                                                            <li>
                                                                <b>Fecha de creación:</b>
                                                                <!--TRAE
                                                                SOLO LA FECHA SIN LA HORA-->
                                                                <t
                                                                    t-out="object.create_date.strftime('%d/%m/%Y')"/>
                                                            </li>
                                                            <li>
                                                                <b>Descripción:</b>
                                                                <t t-out="object.description"/>
                                                            </li>
                                                        </ul>
                                                        <br/>
                                                        <p>
                                                            Para más información, por favor ingrese
                                                            al sistema y
                                                            consulte la oportunidad. Muchas gracias
                                                            por su atención.
                                                        </p>
                                                    </td>
                                                </tr>
                                            </table>
                                            <tr>
                                                <td style="text-align:center;">
                                                    <hr width="100%"
                                                        style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                                                </td>
                                            </tr>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="center" style="min-width: 750px;">
                                            <table border="0" cellpadding="0" cellspacing="0"
                                                width="750"
                                                style="min-width: 750px; background-color: white; font-size: 11px; border-collapse:separate;">
                                                <tr>
                                                    <td valign="middle" align="left">
                                                        <t t-out="object.enterprise_id.name"/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td valign="middle" align="left"
                                                        style="opacity: 0.7;">
                                                        <t t-out="object.env.user.name"/>
                                                        <t t-if="object.env.user.login"> | <a
                                                                t-att-href="'mailto:%s' % object.env.user.login"
                                                                style="text-decoration:none; color: #454748;"
                                                                t-out="object.env.user.login"/>
                                                        </t>
                                                        <t> | <a
                                                                href="http://3.138.67.238/"
                                                                style="text-decoration:none; color: #22103F;">
                                                            http://3.138.67.238/
                                                            </a>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="min-width: 750px;">
                            <table border="0" cellpadding="0" cellspacing="0" width="750"
                                style="min-width: 750px; background-color: #F1F1F1; color: #454748; padding: 8px; border-collapse:separate;"/>
                        </td>
                    </tr>
                </table>
            </field>
        </record>


    </data>
</odoo>