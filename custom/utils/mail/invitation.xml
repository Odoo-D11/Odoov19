<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="auth_signup.mail_template_user_signup_account_created" model="mail.template">
            <field name="name">Portal Welcome Email</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="email_from">odoo@tsg.net.co</field>
            <field name="subject">Welcome to the Portal</field>
            <field name="body_html" type="html">
                <div style="margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:#222;">
                    <p style="font-size:13px;margin:0 0 10px 0;line-height:1.45;">
                        <t t-esc="object.name"/>, welcome to the portal! We're glad to have you. </p>
                </div>
            </field>
        </record>


    </data>
</odoo>