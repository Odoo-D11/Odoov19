<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="WidgetRemainingDaysTemplate" t-inherit="web.DateTimeField">
        <xpath expr="//div[@t-ref='root']" position="inside">
            <t t-if="props.record.data and shouldDisplayWidget()">
                <span t-att-style="'color:' + getRemainingDaysColor() + ';'"
                    class="remaining-days-message">
                    <t t-esc="getRemainingDays()"/>
                </span>
            </t>
        </xpath>
    </t>
</templates>