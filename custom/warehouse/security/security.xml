<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record model="ir.module.category" id="category_module_warehouse">
        <field name="name">Inventario</field>
        <field name="sequence">30</field>
    </record>

    <record model="res.groups.privilege" id="category_warehouse">
        <field name="name">Inventario</field>
        <field name="sequence">31</field>
        <field name="category_id" ref="category_module_warehouse"/>
    </record>

    <record id="group_consult_warehouse" model="res.groups">
        <field name="name">Consulta</field>
        <field name="comment">Consulta de inventario</field>
        <field name="privilege_id" ref="warehouse.category_warehouse"/>
    </record>

    <record id="group_creator_warehouse" model="res.groups">
        <field name="name">Creador</field>
        <field name="comment">Creador</field>
        <field name="privilege_id" ref="warehouse.category_warehouse"/>
        <field name="implied_ids"
            eval="[(4, ref('warehouse.group_consult_warehouse'))]"/>
    </record>

    <record id="group_manager_warehouse" model="res.groups">
        <field name="name">Administrador</field>
        <field name="comment">Permisos completos</field>
        <field name="privilege_id" ref="warehouse.category_warehouse"/>
        <field name="implied_ids"
            eval="[(4, ref('warehouse.group_creator_warehouse'))]"/>
    </record>

</odoo>