            sequence="3"
        />

        <menuitem
            id="menu_warehouse_inventory_adjustments"
            name="Ajustes"
            parent="menu_warehouse_operations"
            sequence="4"
        />

        <menuitem
            id="menu_warehouse_physical_inventory"
            name="Inventario físico"
            parent="menu_warehouse_inventory_adjustments"
            action="action_view_warehouse_physical_inventory"
            sequence="1"
        />

        <menuitem
            id="menu_warehouse_scrap_management"
            name="Chatarra"
            parent="menu_warehouse_inventory_adjustments"
            action="action_view_warehouse_scrap_management"
            sequence="2"
        />

        <menuitem
            id="menu_warehouse_product"
            name="Productos"
            parent="menu_warehouse_root"
            sequence="3"
        />

        <menuitem
            id="menu_warehouse_product_management"
            name="Productos"
