            parent="menu_warehouse_root"
            sequence="4"
        />

        <menuitem
            id="menu_warehouse_configuration"
            name="Configuración"
            parent="menu_warehouse_root"
            sequence="90"
        />


        <menuitem
            id="menu_warehouse_product_category"
            name="Categorías"
            parent="menu_warehouse_configuration"
            action="action_view_warehouse_product_category"
            sequence="1"
        />

        <menuitem
            id="menu_warehouse_uom"
            name="Unidades de Medida"
            parent="menu_warehouse_configuration"
            action="action_view_warehouse_uom"
            sequence="2"
        />

    </data>
</odoo>