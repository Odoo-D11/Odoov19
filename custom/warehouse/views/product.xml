<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_warehouse_product_search" model="ir.ui.view">
            <field name="name">warehouse.product.search</field>
            <field name="model">warehouse.product</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Nombre"/>
                    <field name="type_product_id" string="Tipo de Producto"/>
                    <field name="category_id" string="Categoría"/>
                    <field name="sku" string="SKU"/>
                    <field name="barcode" string="Código de Barras"/>
                    <field name="variant_ids" string="Variante"
                        filter_domain="[('variant_ids.name','ilike',self)]"/>
                    <filter name="filter_type_product" string="Producto"
                        domain="[('type_product_id.name','=','Producto')]"/>
                    <filter name="filter_type_service" string="Servicio"
                        domain="[('type_product_id.name','=','Servicio')]"/>
                    <filter name="filter_type_consumable" string="Consumible"
                        domain="[('type_product_id.name','=','Consumible')]"/>
                    <separator/>
                    <group name="group_by">
                        <filter name="group_by_category" string="Categoría"
                            context="{'group_by':'category_id'}"/>
                        <filter name="group_by_type_product" string="Tipo de Producto"
                            context="{'group_by':'type_product_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_warehouse_product_list" model="ir.ui.view">
            <field name="name">warehouse.product.list</field>
            <field name="model">warehouse.product</field>
            <field name="arch" type="xml">
                <list string="Productos en Almacén" duplicate="false">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="view_warehouse_product_form" model="ir.ui.view">
            <field name="name">warehouse.product.form</field>
            <field name="model">warehouse.product</field>
            <field name="arch" type="xml">
                <form string="Product" duplicate="false">
                    <sheet>
                        <div class="row">
                            <div class="col-lg-7">
                                <span style="font-weight: 500; color: #212529;">
                                    Nombre
                                </span>
                                <div class="form-title-responsive mb-4">
                                    <h1>
                                        <field name="name"
                                            placeholder="Ej. Abrazadera Metalica, Bateria, Cable Utp, etc..."
                                            nolabel="1" class="o_field_char o_field_title"/>
                                    </h1>
                                    <div>
                                        <field name="type_product_id" class="w-100 text-primary"
                                            placeholder="¿Qué tipo de producto es? Ej. [PRO] Producto (Bienes físicos, Ej. Tecnología, Portátiles, Firewall, UPS), [SER] Servicio (Consultoría, Mantenimiento, etc.)"
                                            options="{'no_create': True, 'no_open': True}"/>
                                    </div>
                                </div>
                                <group>
                                    <field name="sku" class="text-primary"
                                        placeholder="Ej. REF-001, SKU-12345, etc..."/>
                                    <field name="barcode" class="text-primary"
                                        placeholder="Ej. 7702004003508, 770492808274, etc..."/>
                                    <field name="category_id" class="text-primary"
                                        options="{'no_create': True, 'no_open': True}"
                                        placeholder="Ej. [EE] Equipo Electrónico, [FE] Ferretería, [SU] Suministros, etc..."/>
                                </group>
                                <div class="mt-3">
                                    <field name="description"
                                        placeholder="Descripción del producto..." nolabel="1"/>
                                </div>
                            </div>
                            <div class="col-lg-5 d-flex">
                                <div class="o_timeline_sidebar flex-grow-1">
                                    <field name="variant_ids" nolabel="1" widget="VariantBoard"/>
                                </div>
                            </div>
                        </div>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_warehouse_product_variant_popup" model="ir.ui.view">
            <field name="name">warehouse.product.variant.popup</field>
            <field name="model">warehouse.product</field>
            <field name="arch" type="xml">
                <form string="Variantes">
                    <sheet>
                        <separator string="Variantes"/>
                        <p class="text-muted">Las variantes permiten gestionar distintas versiones
                            de un mismo producto, como tamaños, colores o configuraciones
                            específicas, sin necesidad de crear productos separados. Cada variante
                            puede tener su propio precio estimado y otros atributos individuales, lo
                            que facilita una gestión más precisa del catálogo. En esta sección
                            puedes agregar, editar o eliminar variantes según sea necesario.
                        </p>
                        <field name="variant_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="name" string="Nombre"
                                    placeholder="Marca | Modelo | Especificaciones..."/>
                                <field name="estimated_price" string="Precio estimado"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_warehouse_product_search" model="ir.ui.view">
            <field name="name">warehouse.product.search</field>
            <field name="model">warehouse.product</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Nombre"/>
                    <field name="type_product_id" string="Tipo de Producto"/>
                    <field name="category_id" string="Categoría"/>
                    <field name="sku" string="SKU"/>
                    <field name="barcode" string="Código de Barras"/>
                    <field name="variant_ids" string="Variante"
                        filter_domain="[('variant_ids.name','ilike',self)]"/>
                    <filter name="filter_type_product" string="Producto"
                        domain="[('type_product_id.name','=','Producto')]"/>
                    <filter name="filter_type_service" string="Servicio"
                        domain="[('type_product_id.name','=','Servicio')]"/>
                    <filter name="filter_type_consumable" string="Consumible"
                        domain="[('type_product_id.name','=','Consumible')]"/>
                    <separator/>
                    <group name="group_by">
                        <filter name="group_by_category" string="Categoría"
                            context="{'group_by':'category_id'}"/>
                        <filter name="group_by_type_product" string="Tipo de Producto"
                            context="{'group_by':'type_product_id'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>