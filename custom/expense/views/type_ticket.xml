<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_expense_type_ticket_list" model="ir.ui.view">
            <field name="name">expense.type.ticket.list</field>
            <field name="model">expense.type.ticket</field>
            <field name="arch" type="xml">
                <list string="Tipos de Ticket" duplicate="false" editable="bottom">
                    <field name="name" placeholder="Ej. Basico, Estandar, Premium, etc."/>
                    <field name="description"
                        placeholder="Ej. 1 pieza incluida mochila o artículo personal, etc."/>
                </list>
            </field>
        </record>

    </data>
</odoo>