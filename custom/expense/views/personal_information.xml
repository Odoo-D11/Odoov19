<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_personal_information_form" model="ir.ui.view">
            <field name="name">expense.personal.information.form</field>
            <field name="model">expense.personal.information</field>
            <field name="arch" type="xml">
                <form string="Información Personal" duplicate="false" create="false" delete="false">
                    <field name="country_id" invisible="1"/>
                    <field name="sequence" invisible="1"/>
                    <sheet>
                        <span style="font-weight: 500; color: #212529;">
                            Nombre
                        </span>
                        <div class="form-title-responsive">
                            <h1 class="mb-1 text-truncate">
                                <field name="partner_id"
                                    options="{'no_create': True, 'no_open': True}"
                                    class="text-primary"
                                    placeholder="Ej. Dwight Schrute, Pam Beesly, Creed Bratton, etc.."/>
                            </h1>
                            <div>
                                <field name="job_title"
                                    placeholder="¿Cuál es el cargo del contacto? Ej. Gerente de ventas, Analista de sistemas, etc.."/>
                            </div>
                        </div>
                        <separator string="Información privada"/>
                        <p class="oe_grey">
                            Esta sección contiene la información personal de la persona, incluyendo
                            campos como nombre, dirección, número de identificación, fecha de
                            nacimiento y otros datos relevantes que permiten identificar y gestionar
                            correctamente al individuo dentro del sistema.
                        </p>
                        <group>
                            <group>
                                <label for="nuid" string="Nro. identificación"/>
                                <div class="o_row">
                                    <field name="identification_type_id"
                                        placeholder="Ej. Cédula de ciudadanía, Tarjeta de identidad, etc.."
                                        options="{'no_create': True, 'no_open': True}"/>
                                    <field name="nuid"
                                        placeholder="Ej. 123456789"/>
                                </div>
                                <field name="birth_date" placeholder="Ej. 01/01/1990"/>
                            </group>
                            <group>
                                <field name="phone" placeholder="Ej. 313 123 4567"
                                    widget="CodeCountryPhone"/>
                                <field name="email" placeholder="Ej. dwight@dundermifflin.com"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>