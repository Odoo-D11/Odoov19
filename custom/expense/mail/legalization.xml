                            </t>
                        </li>
                        <li>
                            <strong>Total legalizado:</strong> $ <t
                                t-esc="'{:,.0f}'.format(ctx.get('evidence_amount', 0)).replace(',','.')"/>
                        </li>
                        <li>
                            <strong>Empresa:</strong>
                            <t t-esc="object.enterprise_id.name or '—'"/>
                        </li>
                    </ul>
                    <p style="font-size:13px;margin:0 0 10px 0;line-height:1.45;">
                        <t t-if="is_fully_legalized"> La solicitud ha sido <strong
                                style="color:#017e84;">legalizada completamente</strong>. No hay
                            valores pendientes por reembolsar. </t>
                        <t t-elif="not object.attached_evidence"> Falta realizar una <strong
                                style="color:#ef4444;">legalización
                                adicional</strong> por el valor pendiente de <strong>$ <t
                                    t-esc="'{:,.0f}'.format(pending_amount).replace(',','.')"/></strong>
                            . </t>
                        <t t-else=""> La solicitud quedo con un saldo pendiente de: <strong>
                                <span
                                    style="color: #017e84;">$ <t
                                        t-esc="'{:,.0f}'.format(pending_amount).replace(',','.')"/>
                            por legalizar </span>
                            </strong>. </t>
                    </p>
                </div>
            </field>
        </record>

        <record id="mail_template_expense_no_reimbursement" model="mail.template">
            <field name="name">Solicitud marcada como no reembolsable</field>
            <field name="model_id" ref="expense.model_expense_expense"/>
            <field name="subject">Solicitud {{ object.reference }}</field>
            <field name="body_html" type="html">
                <div style="margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:#222;">
                    <t t-set="main_amount"
                        t-value="object.approved_amount if object.approved_amount else object.requested_amount"/>
                    <t t-set="pending_amount" t-value="main_amount - object.legalized_amount"/>
                    <t t-set="hour_ctx" t-value="(ctx and ctx.get('hour')) or None"/>
                    <t t-set="hour"
                        t-value="hour_ctx if hour_ctx is not None else datetime.datetime.now().hour"/>
                    <t t-set="saludo"
                        t-value="'Buenos días' if hour &lt; 12 else ('Buenas tardes' if hour &lt; 19 else 'Buenas noches')"/>
                    <p style="font-size:13px;margin:0 0 10px 0;line-height:1.45;">
                        <t t-esc="saludo"/>, </p>
                    <p style="font-size:13px;margin:0 0 14px 0;line-height:1.5;"> El usuario <strong>
                            <t t-esc="object.employee_id.name"/>
                        </strong> ha
                        decidido no reembolsar el valor pendiente de <strong>$ <t
                                t-esc="'{:,.0f}'.format(pending_amount).replace(',','.')"/></strong>.
                        Si requiere información adicional, puede comunicarse con el responsable de
                        la solicitud. Puede consultar más detalles en la plataforma <t
                            t-set="website_url" t-value="object.get_base_url()"/> <a
                            t-att-href="website_url" target="_blank"
                            style="color:#1155cc;text-decoration:underline;">aquí</a>. A
                        continuación, se muestran los detalles de la solicitud: </p>
                    <ul style="font-size:13px;margin:0 0 18px 18px;padding:0;line-height:1.4;">
                        <li>
                            <strong>Referencia:</strong>
                            <t t-esc="object.reference"/>
                        </li>
                        <li>
                            <strong>Asunto:</strong>
                            <t t-esc="object.subject"/>
                        </li>
                        <li>
                            <strong>Categoría:</strong>
                            <t t-esc="(object.category_id and object.category_id.name) or '—'"/>
                        </li>
                        <li>
                            <strong>Proyecto:</strong>
                            <t t-esc="(object.project_id and object.project_id.name) or '—'"/>
                        </li>
                        <li>
                            <strong>Empleado:</strong>
                            <t t-esc="(object.employee_id and object.employee_id.name) or '—'"/>
                        </li>
                        <li>
                            <strong>Total solicitado:</strong> $ <t
                                t-esc="'{:,.0f}'.format(object.requested_amount).replace(',','.')"/>
                            <t
                                t-if="object.approved_amount != 0"> | <strong>Total aprobado:</strong>
                            $ <t t-esc="'{:,.0f}'.format(object.approved_amount).replace(',','.')"/>
                            </t>
                        </li>
                        <li t-if="object.legalized_amount != 0">
                            <strong>Total legalizado:</strong> $ <t
                                t-esc="'{:,.0f}'.format(object.legalized_amount).replace(',','.')"/>
                        </li>
                        <li>
                            <strong>Empresa:</strong>
                            <t t-esc="object.enterprise_id.name or '—'"/>
                        </li>
                    </ul>
                </div>
            </field>
        </record>

    </data>
</odoo>