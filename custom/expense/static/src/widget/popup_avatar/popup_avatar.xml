<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="ExpPartnerPopupTemplate">
        <div class="d-flex align-items-center">
            <div style="flex: 1;">
                <t t-call="web.Many2OneField"/>
            </div>
            <t t-if="personalInfo.partnerId and personalInfo.ready">
                <span t-key="partnerId" class="o_avatar o_m2o_avatar ms-2">
                    <button type="button" t-on-click="openPersonalInfo"
                        class="btn btn-link p-0 exp-personal-info-btn"
                        style="border: none; background: none;">
                        <t t-if="!personalInfo.exists">
                            <i class="fa fa-exclamation-triangle text-danger"
                                title="Faltan datos personales"/>
                        </t>
                        <t t-else="">
                            <i class="fa fa-exclamation-circle text-info"
                                title="Ver información personal"/>
                        </t>
                    </button>
                </span>
            </t>
        </div>
    </t>
</templates>