<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.module.category" id="category_module_project_management">
        <field name="name">Proyectos</field>
        <field name="sequence">23</field>
    </record>

    <record model="res.groups.privilege" id="category_project_management">
        <field name="name">Proyectos</field>
        <field name="sequence">27</field>
        <field name="category_id" ref="category_module_project_management"/>
    </record>

    <record id="group_consult_project_management" model="res.groups">
        <field name="name">Consulta</field>
        <field name="comment">Consulta de proyectos</field>
        <field name="privilege_id" ref="project_management.category_project_management"/>
    </record>

    <record id="group_creator_project_management" model="res.groups">
        <field name="name">Creador</field>
        <field name="comment">Creador de proyectos</field>
        <field name="privilege_id" ref="project_management.category_project_management"/>
        <field name="implied_ids"
            eval="[(4, ref('project_management.group_consult_project_management'))]"/>
    </record>

    <record id="group_manager_project_management" model="res.groups">
        <field name="name">Administrador</field>
        <field name="comment">Permisos completos</field>
        <field name="privilege_id" ref="project_management.category_project_management"/>
        <field name="implied_ids"
            eval="[(4, ref('project_management.group_creator_project_management'))]"/>
    </record>
</odoo>