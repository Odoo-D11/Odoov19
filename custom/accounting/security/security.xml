<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record model="ir.module.category" id="category_module_accounting">
        <field name="name">Contabilidad</field>
        <field name="sequence">28</field>
    </record>

    <record model="res.groups.privilege" id="category_accounting">
        <field name="name">Contabilidad</field>
        <field name="sequence">29</field>
        <field name="category_id" ref="category_module_accounting"/>
    </record>

    <record id="group_consult_accounting" model="res.groups">
        <field name="name">Consulta</field>
        <field name="comment">Consulta de cuentas analíticas, plazos de pago, etc...</field>
        <field name="privilege_id" ref="category_accounting"/>
    </record>

    <record id="group_creator_accounting" model="res.groups">
        <field name="name">Creador</field>
        <field name="comment">Creador de cuentas analíticas, plazos de pago, etc...</field>
        <field name="privilege_id" ref="category_accounting"/>
        <field name="implied_ids" eval="[(4, ref('accounting.group_consult_accounting'))]"/>
    </record>

    <record id="group_manager_accounting" model="res.groups">
        <field name="name">Administrador</field>
        <field name="comment">Permisos completos de contabilidad</field>
        <field name="privilege_id" ref="category_accounting"/>
        <field name="implied_ids" eval="[(4, ref('accounting.group_creator_accounting'))]"/>
    </record>


</odoo>