<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mail_template_rfq_to_project_leader" model="mail.template">
            <field name="name">Enviar solicitud de cotización para aprobar Líder de Proyecto</field>
            <field name="model_id" ref="purchase_management.model_request_quotation"/>
            <field name="email_from">odoo@tsg.net.co</field>
            <field name="subject">Solicitud de Cotización - {{ object.subject }}</field>
            <field name="body_html" type="html">
                <div style="margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:#222;">
                    <p style="font-size:13px;margin:0 0 10px 0;line-height:1.45;">
                        Estimado Líder de Proyecto,
                    </p>
                    <p style="font-size:13px;margin:0 0 14px 0;line-height:1.5;"> Se le informa que
                        el área de compras ha completado la asignación de cotizaciones para la
                        Solicitud de Cotización con referencia <strong>
                            <t t-out="object.reference"/>
                        </strong> creada el <strong>
                            <t t-out="object.create_date.strftime('%d/%m/%Y')"/>
                        </strong>
                        con el asunto <strong>
                            <t t-out="object.subject"/>. </strong>Las cotizaciones han sido
                        recibidas y se encuentran disponibles para su revisión <t
                            t-set="website_url" t-value="object.get_base_url()"/><a
                            t-att-href="website_url" target="_blank"
                            style="color:#1155cc;text-decoration:underline;">aquí</a>. En este
                        momento, estamos esperando su aprobación y cualquier observación pertinente
                        que considere necesaria para proceder con el proceso. Su retroalimentación
                        es fundamental para garantizar que la selección final cumpla con los
                        requerimientos técnicos y presupuestarios del proyecto. Por favor, revise
                        las cotizaciones y proporcione su respuesta a la mayor brevedad posible para
                        mantener los tiempos establecidos dentro de la fecha límite: <strong>
                            <t
                                t-out="object.deadline and object.deadline.strftime('%d/%m/%Y') or '—'"/>
                        . </strong> A continuación, se detallan las especificaciones de la <strong>Solicitud
                        de Cotización:</strong></p>
                    <p style="font-size:13px;margin:10px 0 0 0;line-height:1.45;">
                        <ul>
                            <li>
                                <strong>Proyecto:</strong>
                                <t t-out="object.project_id.name"/>
                            </li>
                            <li>
                                <strong>Tipo:</strong>
                                <t t-if="object.type_id.name == 'Productos'">[PROD] Productos
                                    (Bienes
                                    físicos, Ej. Tecnología, Portátiles, Firewall, UPS)</t>
                                <t t-if="object.type_id.name == 'Servicios'">[SERV] Servicios
                                    (Consultoría, mantenimiento, etc.)</t>
                                <t t-if="object.type_id.name == 'Mixtos'">[MIXT] Mixtos (Incluye
                                    productos y servicios)</t>
                            </li>
                            <li>
                                <strong>Motivo:</strong>
                                <t t-out="object.reason"/>
                            </li>
                        </ul>
                    </p>
                    <table
                        style="width:100%;border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.35;border-style:solid;border-color:#4d4d4d;border-width:1px 1px 0 1px;color:#000;">
                        <thead>
                            <tr>
                                <td colspan="3"
                                    style="padding:5px 8px;text-align:center;text-transform:uppercase;letter-spacing:.06em;font-weight:700;border-bottom:1px solid #4d4d4d;">
                                    <t t-if="object.type_id.name == 'Productos'">Productos</t>
                                    <t
                                        t-if="object.type_id.name == 'Servicios'">Servicios</t>
                                    <t
                                        t-if="object.type_id.name == 'Mixtos'">Elementos</t>
                                    solicitados </td>
                            </tr>
                            <tr>
                                <th
                                    style="border-top:1px solid #4d4d4d;border-bottom:1px solid #4d4d4d;border-right:1px solid #4d4d4d;padding:5px 8px;text-align:left;font-weight:700;width:60%;">
                                    Nombre
                                </th>
                                <th
                                    style="border-top:1px solid #4d4d4d;border-bottom:1px solid #4d4d4d;border-right:1px solid #4d4d4d;padding:5px 8px;text-align:center;font-weight:700;width:20%;">
                                    Cantidad
                                </th>
                                <th
                                    style="border-top:1px solid #4d4d4d;border-bottom:1px solid #4d4d4d;padding:5px 8px;text-align:center;font-weight:700;width:20%;">
                                    Unidad de Medida
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="all_lines"
                                t-value="object.product_line_ids.sorted('sequence')"/>
                            <t t-foreach="all_lines" t-as="line">
                                <t t-if="not line.display_type">
                                    <!-- Fila del producto -->
                                    <tr>
                                        <td
                                            style="border-bottom:1px solid #4d4d4d;border-right:1px solid #4d4d4d;padding:4px 8px;">
                                            <t t-out="line.name or '—'"/>
                                        </td>
                                        <td
                                            style="border-bottom:1px solid #4d4d4d;border-right:1px solid #4d4d4d;padding:4px 8px;text-align:center;">
                                            <t t-out="'{:,.0f}'.format(line.qty).replace(',','.')"/>
                                        </td>
                                        <td
                                            style="border-bottom:1px solid #4d4d4d;padding:4px 8px;text-align:center;">
                                            <t t-out="line.uom_id and line.uom_id.name or '—'"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-elif="line.display_type == 'line_note'">
                                    <!-- Fila de especificaciones (nota) -->
                                    <tr>
                                        <td colspan="3"
                                            style="border-bottom:1px solid #4d4d4d;padding:4px 8px;background-color:#f5f5f5;font-style:italic;">
                                            <t t-out="line.name or ''"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                    <p style="font-size:13px;margin:14px 0 0 0;line-height:1.45;"> Atentamente,<br/>
                        <t
                            t-out="user.name"/> | <t t-out="user.email"/></p>
                </div>
            </field>
        </record>

    </data>
</odoo>