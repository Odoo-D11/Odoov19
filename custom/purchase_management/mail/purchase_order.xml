<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mail_template_purchase_order" model="mail.template">
            <field name="name">Enviar Orden de Compra al Proveedor</field>
            <field name="model_id" ref="purchase_management.model_purchase_management_order"/>
            <field name="email_from">odoo@tsg.net.co</field>
            <field name="email_to">{{ object.partner_id.email or '' }}</field>
            <field name="subject">{{ object.subject }}</field>
            <field name="body_html" type="html">
                <div style="margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:#222;">
                    <p style="font-size:13px;margin:0 0 10px 0;line-height:1.45;"> Estimado(a) <t
                            t-out="object.partner_id.name or 'Proveedor'"/>, </p>
                    <p style="font-size:13px;margin:0 0 14px 0;line-height:1.5;"> Por medio del
                        presente, nos complace remitir la <strong>Orden de Compra <t
                                t-out="object.reference"/></strong> correspondiente a <strong><t
                                t-out="object.subject"/></strong>.
                        A continuación encontrará el detalle de los
                        <t t-if="object.type_id.name == 'Productos'">productos</t><t
                            t-elif="object.type_id.name == 'Servicios'">servicios</t><t
                            t-else="">ítems</t> solicitados y las condiciones de pago acordadas.
                        Le solicitamos revisar la información y confirmar el recibo de esta orden
                        a la brevedad posible. </p>

                    <table
                        style="width:100%;border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.35;border:1px solid #4d4d4d;color:#000;">
                        <thead>
                            <tr>
                                <td colspan="4"
                                    style="padding:5px 8px;text-align:center;text-transform:uppercase;letter-spacing:.06em;font-weight:700;border-bottom:1px solid #4d4d4d;">
                                    <t t-if="object.type_id.name == 'Productos'">Productos</t>
                                    <t
                                        t-elif="object.type_id.name == 'Servicios'">Servicios</t>
                                    <t
                                        t-else="">Items</t> Solicitados </td>
                            </tr>
                            <tr>
                                <th
                                    style="border-top:1px solid #4d4d4d;border-bottom:1px solid #4d4d4d;border-right:1px solid #4d4d4d;padding:5px 8px;text-align:left;font-weight:700;width:50%;">
                                    Nombre
                                </th>
                                <th
                                    style="border-top:1px solid #4d4d4d;border-bottom:1px solid #4d4d4d;border-right:1px solid #4d4d4d;padding:5px 8px;text-align:center;font-weight:700;width:15%;">
                                    Cantidad
                                </th>
                                <th
                                    style="border-top:1px solid #4d4d4d;border-bottom:1px solid #4d4d4d;border-right:1px solid #4d4d4d;padding:5px 8px;text-align:right;font-weight:700;width:17%;">
                                    Precio Unit.
                                </th>
                                <th
                                    style="border-top:1px solid #4d4d4d;border-bottom:1px solid #4d4d4d;border-right:1px solid #4d4d4d;padding:5px 8px;text-align:right;font-weight:700;width:18%;">
                                    Subtotal
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="object.product_line_ids" t-as="line">
                                <tr>
                                    <td
                                        style="border-bottom:1px solid #4d4d4d;border-right:1px solid #4d4d4d;padding:4px 8px;">
                                        <t t-out="line.product_id.product_id.name"/>
                                        <t t-out="line.product_id.name or '—'"/>
                                    </td>
                                    <td
                                        style="border-bottom:1px solid #4d4d4d;border-right:1px solid #4d4d4d;padding:4px 8px;text-align:center;">
                                        <t t-out="'{:,.0f}'.format(line.qty).replace(',', '.')"/>
                                    </td>
                                    <td
                                        style="border-bottom:1px solid #4d4d4d;border-right:1px solid #4d4d4d;padding:4px 8px;text-align:right;">
                                        <t
                                            t-out="line.price_unit"
                                            t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                    </td>
                                    <td
                                        style="border-bottom:1px solid #4d4d4d;border-right:1px solid #4d4d4d;padding:4px 8px;text-align:right;">
                                        <t
                                            t-out="line.subtotal"
                                            t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="3"
                                    style="padding:5px 8px;text-align:right;font-weight:700;border-top:1px solid #4d4d4d;">
                                    Total
                                </td>
                                <td
                                    style="padding:5px 8px;text-align:right;font-weight:700;border-top:1px solid #4d4d4d;border-right:1px solid #4d4d4d;">
                                    <t
                                        t-out="object.total"
                                        t-options='{"widget": "monetary", "display_currency": object.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <p style="font-size:13px;margin:14px 0 0 0;line-height:1.5;">
                        <strong>Plazo de pago:</strong>
                        <t t-out="object.payment_term or '—'"/>
                    </p>
                    <t t-if="object.trm and object.currency_id.name != 'COP'">
                        <p style="font-size:13px;margin:4px 0 0 0;line-height:1.5;">
                            <strong>Tasa de cambio:</strong>
                            1 <t t-out="object.currency_id.name"/> =
                            $ <t t-out="'{:,.0f}'.format(object.trm).replace(',', '.')"/> COP
                            <t t-if="object.trm_date">
                                — vigente al <t t-out="object.trm_date.strftime('%d/%m/%Y')"/>
                            </t>
                        </p>
                    </t>

                    <p style="font-size:13px;margin:18px 0 0 0;line-height:1.45;"> Agradecemos su
                        atención y quedamos atentos a cualquier consulta o confirmación de recibo de
                        la presente orden.<br/><br/> Cordialmente,<br/>
                        <t
                            t-out="object.env.user.name or ''"/>
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>