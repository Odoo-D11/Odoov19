<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_request_type_list" model="ir.ui.view">
            <field name="name">request.type.list</field>
            <field name="model">request.type</field>
            <field name="arch" type="xml">
