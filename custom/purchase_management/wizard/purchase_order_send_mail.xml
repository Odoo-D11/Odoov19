<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_purchase_order_send_mail_wizard_form" model="ir.ui.view">
            <field name="name">purchase.order.send.mail.wizard.form</field>
            <field name="model">purchase.order.send.mail.wizard</field>
            <field name="arch" type="xml">
                <form string="Enviar Orden de Compra">
                    <field name="order_id" invisible="1"/>
                    <field name="step" invisible="1"/>
                    <sheet>
                        <separator string="Ficha Técnica" invisible="step != 'attachment'"/>
                        <div invisible="step != 'attachment'">
                            <p class="text-muted"> Antes de enviar la orden de compra al proveedor,
                                es <b class="text-primary">obligatorio</b> adjuntar la <b
                                    class="text-primary">ficha técnica</b> del producto o servicio
                                requerido. Este documento es el soporte formal que le permite al
                                proveedor entender con precisión las especificaciones, condiciones y
                                alcance de lo solicitado. Sin este archivo, el correo no podrá ser
                                enviado. El archivo debe estar en formato <b class="text-primary">PDF
                                o Word</b> (.pdf, .doc, .docx) y no debe superar los <b
                                    class="text-primary">10 MB</b>. </p>
                            <group>
                                <group>
                                    <field name="technical_sheet"
                                        filename="technical_sheet_filename" widget="binary"
                                        string="Archivo"/>
                                </group>
                            </group>
                            <field name="technical_sheet_filename" invisible="1"/>
                        </div>

                        <div invisible="step != 'preview'">
                            <group>
                                <field name="subject"/>
                            </group>
                            <field name="body_html" nolabel="1" widget="html"/>
                        </div>

                    </sheet>
                    <footer>
                        <button string="Siguiente" name="action_next" type="object"
                            class="btn-primary" invisible="step != 'attachment'"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"
                            invisible="step != 'attachment'"/>

                        <button string="Confirmar" name="action_send_mail" type="object"
                            class="btn-primary" invisible="step != 'preview'"/>
                        <button string="Volver" name="action_back" type="object"
                            class="btn-secondary" invisible="step != 'preview'"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>