<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record model="ir.module.category" id="category_module_purchase_management">
        <field name="name">Compras</field>
        <field name="sequence">30</field>
    </record>

    <record model="res.groups.privilege" id="category_purchase_management">
        <field name="name">Compras</field>
        <field name="sequence">31</field>
        <field name="category_id" ref="category_module_purchase_management"/>
    </record>

    <record id="group_consult_purchase_management" model="res.groups">
        <field name="name">Consulta</field>
        <field name="comment">Consulta de solicitudes</field>
        <field name="privilege_id" ref="purchase_management.category_purchase_management"/>
    </record>

    <record id="group_purchase_user_management" model="res.groups">
        <field name="name">Compras</field>
        <field name="comment">Permisos de compras</field>
        <field name="privilege_id" ref="purchase_management.category_purchase_management"/>
        <field name="implied_ids"
            eval="[(4, ref('purchase_management.group_consult_purchase_management'))]"/>
    </record>

    <record id="group_purchase_sagrilaft_approval" model="res.groups">
        <field name="name">Compras / SAGRILAFT</field>
        <field name="comment">Permisos de aprobación SAGRILAFT</field>
        <field name="implied_ids"
            eval="[(4, ref('purchase_management.group_consult_purchase_management'))]"/>
    </record>

    <record id="group_accounting_purchase_management" model="res.groups">
        <field name="name">Compras / Contabilidad</field>
        <field name="comment">Permisos de contabilidad</field>
        <field name="implied_ids"
            eval="[(4, ref('purchase_management.group_consult_purchase_management'))]"/>
    </record>

    <record id="group_project_leader_purchase_management" model="res.groups">
        <field name="name">Compras / Líder de Proyecto</field>
        <field name="comment">Creador de solicitudes de cotización</field>
        <field name="implied_ids"
            eval="[(4, ref('purchase_management.group_consult_purchase_management'))]"/>
    </record>

    <record id="group_purchase_committee_approval" model="res.groups">
        <field name="name">Compras / Comité de Compras</field>
        <field name="comment">Permisos del comité de compras</field>
        <field name="implied_ids"
            eval="[(4, ref('purchase_management.group_consult_purchase_management'))]"/>
    </record>

    <record id="group_process_leader_purchase_management" model="res.groups">
        <field name="name">Compras / Líder de proceso</field>
        <field name="comment">Permisos del líder de proceso</field>
        <field name="implied_ids"
            eval="[(4, ref('purchase_management.group_consult_purchase_management'))]"/>
    </record>

    <record id="group_unlock_request_quotation" model="res.groups">
        <field name="name">Compras / Desbloqueo de SDC</field>
        <field name="comment">Permite bloquear y desbloquear solicitudes de cotización</field>
    </record>

    <record id="group_manager_purchase_management" model="res.groups">
        <field name="name">Administrador</field>
        <field name="comment">Permisos completos</field>
        <field name="privilege_id" ref="purchase_management.category_purchase_management"/>
        <field name="implied_ids"
            eval="[
            (4, ref('purchase_management.group_purchase_user_management')),
            (4, ref('purchase_management.group_purchase_committee_approval')),
            (4, ref('purchase_management.group_project_leader_purchase_management')),
            (4, ref('purchase_management.group_purchase_sagrilaft_approval')),
            (4, ref('purchase_management.group_process_leader_purchase_management')),
            (4, ref('purchase_management.group_unlock_request_quotation'))
        ]"/>
    </record>


</odoo>