    </record>

    <!--PROVINCIAS-->

    <record id="contacts.menu_country_state_partner" model="ir.ui.menu">
        <field name="group_ids" eval="[(6,0,[ref('invisible_menu_tag_res_partner')])]"/>
    </record>

    <!--INDUSTRIAS-->

    <record id="contacts.res_partner_industry_menu" model="ir.ui.menu">
