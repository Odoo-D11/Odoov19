    </record>

    <record id="web.download_contact" model="ir.actions.server">
        <field name="group_ids" eval="[(6,0,[ref('invisible_menu_tag_res_partner')])]"/>
    </record>

    <!--ETIQUETAS-->

    <record id="contacts.menu_partner_category_form" model="ir.ui.menu">
        <field name="group_ids" eval="[(6,0,[ref('invisible_menu_tag_res_partner')])]"/>
    </record>

    <!--MENU
    DE CONTACTOS POR DEFECTO-->

    <record id="contacts.res_partner_menu_contacts" model="ir.ui.menu">
        <field name="group_ids" eval="[(6,0,[ref('invisible_menu_tag_res_partner')])]"/>
    </record>

    <record id="privacy_lookup.ir_action_server_action_privacy_lookup_partner"
        model="ir.actions.server">
        <field name="group_ids" eval="[(6,0,[ref('invisible_menu_tag_res_partner')])]"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="portal.partner_wizard_action_create_and_open" model="ir.actions.server">
        <field name="group_ids" eval="[(6,0,[ref('invisible_menu_tag_res_partner')])]"/>
        <field name="binding_model_id" eval="False"/>
    </record>

