    <record id="base.group_partner_manager" model="res.groups">
        <field name="model_access" eval="[(6, 0, [])]"/>
        <field name="user_ids" eval="[(6, 0, [])]"/>
    </record>

    <!--SECURITY-->

    <record model="ir.module.category" id="module_res_partner">
        <field name="name">Contactos</field>
        <field name="sequence">13</field>
    </record>

    <record model="res.groups.privilege" id="module_category_res_partner">
        <field name="name">Contactos</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="module_res_partner"/>
    </record>

    <!-- PERMISO CONSULTA-->

    <record id="group_res_partner_consult" model="res.groups">
        <field name="name">Consulta</field>
        <field name="comment">Permite consultar los contactos</field>
        <field name="privilege_id" ref="module_category_res_partner"/>
    </record>

    <record id="group_res_partner_creator" model="res.groups">
        <field name="name">Creador</field>
        <field name="comment">Permite crear contactos</field>
        <field name="privilege_id" ref="module_category_res_partner"/>
        <field name="implied_ids" eval="[(4, ref('group_res_partner_consult'))]"/>
    </record>

    <record id="group_res_partner_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="comment">Permite administrar contactos</field>
        <field name="privilege_id" ref="module_category_res_partner"/>
        <field name="implied_ids" eval="[(4, ref('group_res_partner_creator'))]"/>
    </record>

</odoo>