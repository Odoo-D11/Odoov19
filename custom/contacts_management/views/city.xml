<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_list_res_city" model="ir.ui.view">
            <field name="name">view.list.res.city</field>
            <field name="model">res.city</field>
            <field name="arch" type="xml">
                <list duplicate="0" editable="bottom" sample="1">
                    <field name="name" placeholder="Ej. Bogotá, Medellín, Cali, etc."/>
                    <field name="state_id" options="{'no_open': True, 'no_create': True}"
                        placeholder="Ej. Cundinamarca, Antioquia, Valle del Cauca, etc."/>
                </list>
            </field>
        </record>
        
    </data>
</odoo>